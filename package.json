{
  "name": "ace-contracting-platform",
  "version": "1.0.0",
  "private": true,
  "description": "ACE Contracting - EPC Site Management Platform for Oil & Gas projects across the UAE",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
