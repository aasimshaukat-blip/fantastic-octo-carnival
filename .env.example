# Database connection
# Development (SQLite):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) — switch provider in prisma/schema.prisma to "postgresql":
# DATABASE_URL="postgresql://user:password@host:5432/ace_contracting?schema=public"

# JWT signing secret — generate with: openssl rand -base64 48
AUTH_SECRET="change-me-in-production-use-a-long-random-string"

# Session lifetime in hours
SESSION_HOURS=12

# Email notifications (SMTP) — optional, future
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# SMS/WhatsApp gateway — optional, future
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
